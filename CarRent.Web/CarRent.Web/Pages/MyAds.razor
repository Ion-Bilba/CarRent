@page "/my-ads"
@attribute [Authorize]
@using System.Security.Claims
@using CarRent.Web.Models.Ads
@using CarRent.Web.Models.Common
@inject AdService AdService
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager NavigationManager

<PageTitle>CarRent - Anunțurile mele</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-4">
    <h3>Anunțurile mele</h3>
    <a href="ads/create" class="btn btn-primary">+ Adaugă Anunț Nou</a>
</div>

@if (isLoading)
{
    <div class="text-center my-5">
        <div class="spinner-border text-primary" role="status"></div>
        <p class="mt-2">Se încarcă anunțurile...</p>
    </div>
}
else if (myAds == null || !myAds.Any())
{
    <div class="alert alert-info d-flex justify-content-between align-items-center" role="alert">
        <span>Nu ai publicat niciun anunț până acum.</span>
        <a href="ads/create" class="btn btn-sm btn-outline-primary">Creează primul anunț</a>
    </div>
}
else
{
    <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
        @foreach (var ad in myAds)
        {
            <div class="col">
                <div class="card h-100 shadow-sm border-0 position-relative">
                    <span class="badge position-absolute top-0 end-0 m-2 @((AdType)ad.AdType == AdType.Sale ? "bg-success" : "bg-warning text-dark")">
                        @((AdType)ad.AdType == AdType.Sale ? "Vânzare" : "Închiriere")
                    </span>

                    <img src="@(string.IsNullOrEmpty(ad.MainImageUrl) ? "images/car-placeholder.png" : ad.MainImageUrl)"
                         class="card-img-top"
                         alt="@ad.Title"
                         style="height: 180px; object-fit: cover;" />

                    <div class="card-body d-flex flex-column">
                        <h5 class="card-title text-truncate mb-1">@ad.Title</h5>
                        <p class="text-primary fw-bold fs-5 mb-2">
                            €@ad.Price.ToString("N0") @((AdType)ad.AdType == AdType.Rent ? "/ zi" : "")
                        </p>
                        <p class="card-text text-muted small text-truncate mb-3">@ad.Description</p>

                        <div class="mt-auto d-flex justify-content-between align-items-center pt-2 border-top">
                            <a href="ads/@ad.Id" class="btn btn-sm btn-outline-secondary">Vezi</a>
                            <div>
                                <a href="ads/edit/@ad.Id" class="btn btn-sm btn-outline-primary me-1">Editează</a>
                                <button class="btn btn-sm btn-outline-danger" @onclick="() => DeleteAd(ad.Id)">Șterge</button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}

@code {
    private List<AdDto>? myAds;
    private bool isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        await LoadMyAds();
    }

    private async Task LoadMyAds()
    {
        isLoading = true;

        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var userIdClaim = authState.User.FindFirst(ClaimTypes.NameIdentifier)?.Value;

        if (Guid.TryParse(userIdClaim, out var currentUserId))
        {
            var pagedResult = await AdService.GetAdsAsync(1, 100);
            if (pagedResult != null)
            {
                myAds = pagedResult.Items.Where(a => a.UserId == currentUserId).ToList();
            }
        }

        isLoading = false;
    }

    private async Task DeleteAd(Guid id)
    {
        var success = await AdService.DeleteAdAsync(id);
        if (success)
        {
            await LoadMyAds();
        }
    }
}