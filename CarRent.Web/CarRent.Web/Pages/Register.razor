@page "/register"
@inject AuthService AuthService
@inject NavigationManager NavigationManager

<PageTitle>CarRent - Înregistrare</PageTitle>

<div class="row justify-content-center mt-5">
    <div class="col-md-6 col-lg-5">
        <div class="card shadow-sm">
            <div class="card-body">
                <h3 class="card-title text-center mb-4">Creare cont</h3>

                @if (!string.IsNullOrEmpty(errorMessage))
                {
                    <div class="alert alert-danger" role="alert">
                        @errorMessage
                    </div>
                }

                @if (registrationSuccess)
                {
                    <div class="alert alert-success" role="alert">
                        Contul a fost creat cu succes! Te redirecționăm către autentificare...
                    </div>
                }
                else
                {
                    <EditForm Model="@registerModel" OnValidSubmit="HandleRegister">
                        <DataAnnotationsValidator />

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label for="firstName" class="form-label">Prenume</label>
                                <InputText id="firstName" class="form-control" @bind-Value="registerModel.FirstName" />
                            </div>

                            <div class="col-md-6 mb-3">
                                <label for="lastName" class="form-label">Nume</label>
                                <InputText id="lastName" class="form-control" @bind-Value="registerModel.LastName" />
                            </div>
                        </div>

                        <div class="mb-3">
                            <label for="email" class="form-label">Email</label>
                            <InputText id="email" class="form-control" @bind-Value="registerModel.Email" placeholder="nume@exemplu.com" />
                        </div>

                        <div class="mb-3">
                            <label for="phoneNumber" class="form-label">Număr de telefon (opțional)</label>
                            <InputText id="phoneNumber" class="form-control" @bind-Value="registerModel.PhoneNumber" />
                        </div>

                        <div class="mb-3">
                            <label for="password" class="form-label">Parolă</label>
                            <InputText id="password" type="password" class="form-control" @bind-Value="registerModel.Password" />
                        </div>

                        <button type="submit" class="btn btn-primary w-100" disabled="@isSubmitting">
                            @if (isSubmitting)
                            {
                                <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                                <span>Se procesează...</span>
                            }
                            else
                            {
                                <span>Înregistrare</span>
                            }
                        </button>
                    </EditForm>
                }

                <div class="mt-3 text-center">
                    <p>Ai deja un cont? <a href="login">Autentifică-te</a></p>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private RegisterRequest registerModel = new();
    private string? errorMessage;
    private bool isSubmitting;
    private bool registrationSuccess;

    private async Task HandleRegister()
    {
        isSubmitting = true;
        errorMessage = null;

        var result = await AuthService.RegisterAsync(registerModel);

        if (result.IsSuccess)
        {
            registrationSuccess = true;
            StateHasChanged();
            await Task.Delay(2000);
            NavigationManager.NavigateTo("login");
        }
        else
        {
            errorMessage = result.ErrorMessage;
        }

        isSubmitting = false;
    }
}