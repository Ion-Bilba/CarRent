@page "/favorites"
@attribute [Authorize]
@using CarRent.Web.Models.Ads
@inject FavoriteService FavoriteService
@inject NavigationManager NavigationManager

<PageTitle>CarRent - Anunțuri Favorite</PageTitle>

<h3 class="mb-4">Anunțurile mele favorite</h3>

@if (isLoading)
{
    <div class="text-center my-5">
        <div class="spinner-border text-primary" role="status"></div>
        <p class="mt-2">Se încarcă favoritele...</p>
    </div>
}
else if (favoriteAds == null || !favoriteAds.Any())
{
    <div class="alert alert-info" role="alert">
        Nu ai adăugat niciun anunț la favorite.
    </div>
}
else
{
    <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
        @foreach (var ad in favoriteAds)
        {
            <div class="col">
                <div class="card h-100 shadow-sm border-0 position-relative">
                    <img src="@ImageUrlHelper.Resolve(ad.MainImageUrl)"
                         class="card-img-top"
                         alt="@ad.Title"
                         style="height: 200px; object-fit: cover;" />
                    
                    <div class="card-body d-flex flex-column">
                        <h5 class="card-title text-truncate">@ad.Title</h5>
                        <p class="card-text text-muted text-truncate">@ad.Description</p>
                        
                        <div class="mt-auto d-flex justify-content-between align-items-center">
                            <span class="fs-5 fw-bold text-primary">€@ad.Price.ToString("N0")</span>
                            <div>
                                <a href="ads/@ad.Id" class="btn btn-outline-primary btn-sm me-2">Detalii</a>
                                <button class="btn btn-outline-danger btn-sm" @onclick="() => RemoveFromFavorites(ad.Id)">
                                    Șterge
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}

@code {
    private List<AdDto>? favoriteAds;
    private bool isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        await LoadFavorites();
    }

    private async Task LoadFavorites()
    {
        isLoading = true;
        favoriteAds = await FavoriteService.GetMyFavoritesAsync();
        isLoading = false;
    }

    private async Task RemoveFromFavorites(Guid adId)
    {
        var success = await FavoriteService.DeleteFavoriteAsync(adId);
        if (success)
        {
            await LoadFavorites();
        }
    }
}