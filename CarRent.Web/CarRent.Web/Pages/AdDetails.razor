@page "/ads/{Id:guid}"
@using CarRent.Web.Models.Ads
@using CarRent.Web.Models.Common
@inject AdService AdService
@inject FavoriteService FavoriteService
@inject NavigationManager NavigationManager

<PageTitle>CarRent - Detalii Anunț</PageTitle>

@if (isLoading)
{
    <div class="text-center my-5">
        <div class="spinner-border text-primary" role="status">
            <span class="visually-hidden">Se încarcă...</span>
        </div>
        <p class="mt-2">Se încarcă detaliile anunțului...</p>
    </div>
}
else if (ad == null)
{
    <div class="alert alert-warning" role="alert">
        Anunțul solicitat nu a fost găsit.
    </div>
    <a href="ads" class="btn btn-secondary">Înapoi la anunțuri</a>
}
else
{
    <div class="container my-4">
        <button class="btn btn-outline-secondary mb-3" @onclick='() => NavigationManager.NavigateTo("ads")'>
            &larr; Înapoi
        </button>

        <div class="row">
            <div class="col-lg-7">
                <div class="card mb-4 shadow-sm border-0">
                    <div class="position-relative">
                        <img src="@ImageUrlHelper.Resolve(CurrentImageUrl)"
                             class="img-fluid rounded-top"
                             alt="@ad.Title"
                             style="width: 100%; height: 400px; object-fit: cover;" />

                        @if (ad.AdImages != null && ad.AdImages.Count > 1)
                        {
                            <button type="button"
                                    class="btn btn-light btn-sm position-absolute top-50 start-0 translate-middle-y ms-2 rounded-circle shadow-sm"
                                    style="width: 40px; height: 40px;"
                                    @onclick="ShowPreviousImage">
                                &larr;
                            </button>
                            <button type="button"
                                    class="btn btn-light btn-sm position-absolute top-50 end-0 translate-middle-y me-2 rounded-circle shadow-sm"
                                    style="width: 40px; height: 40px;"
                                    @onclick="ShowNextImage">
                                &rarr;
                            </button>
                            <span class="badge bg-dark position-absolute bottom-0 end-0 m-2">
                                @(selectedImageIndex + 1) / @ad.AdImages.Count
                            </span>
                        }
                    </div>

                    @if (ad.AdImages != null && ad.AdImages.Count > 1)
                    {
                        <div class="d-flex gap-2 p-2 overflow-auto">
                            @for (int i = 0; i < ad.AdImages.Count; i++)
                            {
                                var index = i;
                                <img src="@ImageUrlHelper.Resolve(ad.AdImages[index].ImageUrl)"
                                     class="img-thumbnail @(index == selectedImageIndex ? "border-primary border-2" : "")"
                                     style="width: 80px; height: 60px; object-fit: cover; cursor: pointer;"
                                     alt="Thumb @(index + 1)"
                                     @onclick="() => SelectImage(index)" />
                            }
                        </div>
                    }
                </div>
            </div>

            <div class="col-lg-5">
                <div class="card shadow-sm border-0 p-4">
                    <h2 class="fw-bold mb-3">@ad.Title</h2>

                    <div class="d-flex justify-content-between align-items-center mb-4">
                        <h3 class="text-primary fw-bold mb-0">€@ad.Price.ToString("N0")</h3>
                        <AuthorizeView>
                            <Authorized>
                                <button class="btn @(isFavorite ? "btn-danger" : "btn-outline-danger")" @onclick="ToggleFavorite">
                                    @(isFavorite ? "♥ Salvat la Favorite" : "♡ Adaugă la Favorite")
                                </button>
                            </Authorized>
                        </AuthorizeView>
                    </div>

                    <hr />

                    <h5 class="fw-bold">Specificații</h5>
                    <table class="table table-sm mb-4">
                        <tbody>
                            <tr><td class="text-muted">Marcă & Model</td><td class="fw-bold">@ad.CarBrand @ad.CarModel</td></tr>
                            <tr><td class="text-muted">An fabricație</td><td>@ad.CarYear</td></tr>
                            <tr><td class="text-muted">Culoare</td><td>@ad.CarColor</td></tr>
                            <tr><td class="text-muted">Rulaj</td><td>@ad.CarMileage.ToString("N0") km</td></tr>
                            <tr><td class="text-muted">Capacitate motor</td><td>@ad.CarEngineCapacity cm³</td></tr>
                            <tr><td class="text-muted">Combustibil</td><td>@ad.CarFuelType</td></tr>
                            <tr><td class="text-muted">Transmisie</td><td>@ad.CarTransmission</td></tr>
                            <tr><td class="text-muted">Tracțiune</td><td>@ad.TractionType</td></tr>
                        </tbody>
                    </table>

                    <h5 class="fw-bold">Descriere</h5>
                    <p class="text-muted">@ad.Description</p>

                    <div class="mt-4 text-muted small">
                        <p class="mb-1">Vizualizări: <strong>@ad.Views</strong></p>
                        <p class="mb-0">Publicat la: <strong>@ad.CreatedAt.ToString("dd.MM.yyyy")</strong></p>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter]
    public Guid Id { get; set; }

    private AdDto? ad;
    private bool isLoading = true;
    private bool isFavorite;
    private int selectedImageIndex = 0;

    private string? CurrentImageUrl =>
        ad?.AdImages != null && ad.AdImages.Count > 0
            ? ad.AdImages[selectedImageIndex].ImageUrl
            : ad?.MainImageUrl;

    protected override async Task OnInitializedAsync()
    {
        isLoading = true;
        ad = await AdService.GetAdByIdAsync(Id);

        if (ad != null)
        {
            isFavorite = await FavoriteService.IsFavoriteAsync(Id);
        }

        isLoading = false;
    }

    private void SelectImage(int index)
    {
        selectedImageIndex = index;
    }

    private void ShowNextImage()
    {
        if (ad?.AdImages == null || ad.AdImages.Count == 0) return;
        selectedImageIndex = (selectedImageIndex + 1) % ad.AdImages.Count;
    }

    private void ShowPreviousImage()
    {
        if (ad?.AdImages == null || ad.AdImages.Count == 0) return;
        selectedImageIndex = (selectedImageIndex - 1 + ad.AdImages.Count) % ad.AdImages.Count;
    }

    private async Task ToggleFavorite()
    {
        if (isFavorite)
        {
            var success = await FavoriteService.DeleteFavoriteAsync(Id);
            if (success)
            {
                isFavorite = false;
            }
        }
        else
        {
            var success = await FavoriteService.AddFavoriteAsync(Id);
            if (success)
            {
                isFavorite = true;
            }
        }
    }
}