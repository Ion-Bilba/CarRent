@page "/ads/create"
@using CarRent.Web.Models.Ads
@using CarRent.Web.Models.Cars
@using Microsoft.AspNetCore.Components.Forms
@inject CarService CarService
@inject AdService AdService
@inject NavigationManager Navigation

<div class="container mt-4" style="max-width: 700px;">
    <div class="card shadow-sm p-4">
        <h3 class="mb-4">Adaugă un anunț nou</h3>

        <EditForm Model="@adModel" OnValidSubmit="HandleSubmit">
            <DataAnnotationsValidator />

            <!-- Selectare Mașină din DB -->
            <div class="mb-3">
                <label class="form-label fw-bold">Selectează Mașina</label>
                @if (userCars == null)
                {
                    <p><em>Se încarcă mașinile tale...</em></p>
                }
                else if (!userCars.Any())
                {
                    <div class="alert alert-warning">
                        Nu ai nicio mașină înregistrată. <a href="cars/create">Adaugă mai întâi o mașină</a>.
                    </div>
                }
                else
                {
                    <InputSelect @bind-Value="adModel.CarId" class="form-select">
                        <option value="">-- Alege o mașină --</option>
                        @foreach (var car in userCars)
                        {
                            <option value="@car.Id">@car.Brand @car.Model (@car.Year)</option>
                        }
                    </InputSelect>
                }
            </div>

            <div class="mb-3">
                <label class="form-label">Titlu Anunț</label>
                <InputText @bind-Value="adModel.Title" class="form-control" placeholder="ex: BMW M5 F90 stare impecabilă" />
            </div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label class="form-label">Tip Anunț</label>
                    <InputSelect @bind-Value="adModel.AdType" class="form-select">
                        <option value="Rent">Închiriere (Rent)</option>
                        <option value="Sale">Vânzare (Sale)</option>
                    </InputSelect>
                </div>
                <div class="col-md-6 mb-3">
                    <label class="form-label">Preț (€)</label>
                    <InputNumber @bind-Value="adModel.Price" class="form-control" />
                </div>
            </div>

            <div class="mb-3">
                <label class="form-label">Descriere</label>
                <InputTextArea @bind-Value="adModel.Description" class="form-control" rows="4" />
            </div>

            <div class="d-flex justify-content-end gap-2">
                <a href="ads" class="btn btn-outline-secondary">Anulează</a>
                <button type="submit" class="btn btn-primary" disabled="@isSubmitting">
                    @(isSubmitting ? "Se salvează..." : "Salvează Anunțul")
                </button>
            </div>
        </EditForm>
    </div>
</div>

@code {
    private CreateAdRequest adModel = new();
    private List<CarDto> userCars = new();
    private bool isSubmitting = false;

    protected override async Task OnInitializedAsync()
    {
        userCars = await CarService.GetMyCarsAsync();
    }

    private async Task HandleSubmit()
    {
        if (adModel.CarId == Guid.Empty) return;

        isSubmitting = true;

        var createdId = await AdService.CreateAdAsync(adModel);

        isSubmitting = false;

        if (createdId != null)
        {
            Navigation.NavigateTo("/ads");
        }
    }
}