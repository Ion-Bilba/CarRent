@page "/ads"
@using CarRent.Web.Models.Ads
@using CarRent.Web.Models.Cars
@using CarRent.Web.Models.Common
@inject AdService AdService
@inject NavigationManager NavigationManager

<PageTitle>CarRent - Anunțuri</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-4">
    <h3 class="mb-0">Anunțuri disponibile</h3>
    <a href="ads/create" class="btn btn-primary">
        + Adaugă Anunț Nou
    </a>
</div>

<!-- Filtre AdType -->
<div class="btn-group mb-3" role="group" aria-label="Filtru tip anunț">
    <button type="button" class="btn @(filter.AdType == null ? "btn-primary" : "btn-outline-primary")" @onclick="() => FilterByAdType(null)">
        Toate
    </button>
    <button type="button" class="btn @(filter.AdType == AdType.Sale ? "btn-primary" : "btn-outline-primary")" @onclick="() => FilterByAdType(AdType.Sale)">
        🚗 De vânzare
    </button>
    <button type="button" class="btn @(filter.AdType == AdType.Rent ? "btn-primary" : "btn-outline-primary")" @onclick="() => FilterByAdType(AdType.Rent)">
        🔑 De închiriat
    </button>
</div>

<!-- Bară de filtrare avansată -->
<div class="card shadow-sm border-0 mb-4 p-3">
    <div class="row g-2 align-items-end">
        <div class="col-6 col-md-2">
            <label class="form-label small mb-1">Marcă</label>
            <input class="form-control form-control-sm" @bind="filter.Brand" @bind:event="oninput" placeholder="ex: BMW" />
        </div>
        <div class="col-6 col-md-2">
            <label class="form-label small mb-1">Model</label>
            <input class="form-control form-control-sm" @bind="filter.Model" @bind:event="oninput" placeholder="ex: M5" />
        </div>
        <div class="col-6 col-md-1">
            <label class="form-label small mb-1">An min</label>
            <input type="number" class="form-control form-control-sm" @bind="filter.MinYear" />
        </div>
        <div class="col-6 col-md-1">
            <label class="form-label small mb-1">An max</label>
            <input type="number" class="form-control form-control-sm" @bind="filter.MaxYear" />
        </div>
        <div class="col-6 col-md-2">
            <label class="form-label small mb-1">Combustibil</label>
            <select class="form-select form-select-sm" @bind="filter.FuelType">
                <option value="">Toate</option>
                @foreach (var fuel in Enum.GetValues<FuelType>())
                {
                    <option value="@fuel">@fuel</option>
                }
            </select>
        </div>
        <div class="col-6 col-md-2">
            <label class="form-label small mb-1">Cutie</label>
            <select class="form-select form-select-sm" @bind="filter.Transmission">
                <option value="">Toate</option>
                @foreach (var trans in Enum.GetValues<Transmission>())
                {
                    <option value="@trans">@trans</option>
                }
            </select>
        </div>
        <div class="col-6 col-md-2">
            <label class="form-label small mb-1">Tracțiune</label>
            <select class="form-select form-select-sm" @bind="filter.TractionType">
                <option value="">Toate</option>
                @foreach (var trac in Enum.GetValues<TractionType>())
                {
                    <option value="@trac">@trac</option>
                }
            </select>
        </div>
        <div class="col-6 col-md-2 mt-2">
            <button class="btn btn-primary btn-sm w-100" @onclick="ApplyFilters">Caută</button>
        </div>
        @if (filter.HasAnyFilter)
        {
            <div class="col-6 col-md-2 mt-2">
                <button class="btn btn-outline-secondary btn-sm w-100" @onclick="ResetFilters">Resetează filtrele</button>
            </div>
        }
    </div>
</div>

@if (isLoading)
{
    <div class="text-center my-5">
        <div class="spinner-border text-primary" role="status">
            <span class="visually-hidden">Se încarcă...</span>
        </div>
        <p class="mt-2">Se încarcă anunțurile...</p>
    </div>
}
else if (hasError)
{
    <div class="alert alert-danger" role="alert">
        Nu am putut încărca anunțurile. Încearcă din nou mai târziu.
    </div>
}
else if (pagedResult == null || !pagedResult.Items.Any())
{
    <div class="alert alert-info" role="alert">
        Nu există anunțuri disponibile pentru filtrul selectat.
    </div>
}
else
{
    <div class="row row-cols-1 row-cols-sm-2 row-cols-lg-3 row-cols-xl-4 g-4">
        @foreach (var ad in pagedResult.Items)
        {
            <div class="col">
                <div class="card h-100 shadow-sm border-0 position-relative">
                    <span class="badge position-absolute top-0 end-0 m-2 @((AdType)ad.AdType == AdType.Sale ? "bg-success" : "bg-warning text-dark")">
                        @((AdType)ad.AdType == AdType.Sale ? "De vânzare" : "De închiriat")
                    </span>

                    <img src="@ImageUrlHelper.Resolve(ad.MainImageUrl)"
                         class="card-img-top"
                         alt="@ad.Title"
                         style="height: 200px; object-fit: cover;" />

                    <div class="card-body d-flex flex-column">
                        <h5 class="card-title text-truncate">@ad.Title</h5>
                        <p class="small text-muted mb-1">@ad.CarBrand @ad.CarModel &middot; @ad.CarYear &middot; @ad.CarMileage.ToString("N0") km</p>
                        <p class="card-text text-muted text-truncate">@ad.Description</p>

                        <div class="mt-auto d-flex justify-content-between align-items-center">
                            <span class="fs-5 fw-bold text-primary">
                                €@ad.Price.ToString("N0") @((AdType)ad.AdType == AdType.Rent ? "/ zi" : "")
                            </span>
                            <a href="ads/@ad.Id" class="btn btn-outline-primary btn-sm">Vezi detalii</a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}

@code {
    private PagedResult<AdDto>? pagedResult;
    private bool isLoading = true;
    private bool hasError = false;
    private AdFilter filter = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadAds();
    }

    private async Task FilterByAdType(AdType? adType)
    {
        if (filter.AdType == adType) return;
        filter.AdType = adType;
        await LoadAds();
    }

    private async Task ApplyFilters()
    {
        await LoadAds();
    }

    private async Task ResetFilters()
    {
        var keepAdType = filter.AdType;
        filter = new AdFilter { AdType = keepAdType };
        await LoadAds();
    }

    private async Task LoadAds()
    {
        isLoading = true;
        hasError = false;

        pagedResult = await AdService.GetAdsAsync(1, 20, filter);

        if (pagedResult == null)
        {
            hasError = true;
        }

        isLoading = false;
    }
}