@page "/ads"
@inject AdService AdService
@inject NavigationManager NavigationManager

<PageTitle>CarRent - Anunțuri</PageTitle>

<h3 class="mb-4">Anunțuri disponibile</h3>

@if (isLoading)
{
    <div class="text-center my-5">
        <div class="spinner-border text-primary" role="status">
            <span class="visually-hidden">Se încarcă...</span>
        </div>
        <p class="mt-2">Se încarcă anunțurile...</p>
    </div>
}
else if (hasError)
{
    <div class="alert alert-danger" role="alert">
        Nu am putut încărca anunțurile. Încearcă din nou mai târziu.
    </div>
}
else if (pagedResult == null || !pagedResult.Items.Any())
{
    <div class="alert alert-info" role="alert">
        Nu există anunțuri disponibile în acest moment.
    </div>
}
else
{
    <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
        @foreach (var ad in pagedResult.Items)
        {
            <div class="col">
                <div class="card h-100 shadow-sm border-0">
                    <img src="@(string.IsNullOrEmpty(ad.MainImageUrl) ? "images/car-placeholder.png" : ad.MainImageUrl)"
                         class="card-img-top"
                         alt="@ad.Title"
                         style="height: 200px; object-fit: cover;" />
                    <div class="card-body d-flex flex-column">
                        <h5 class="card-title text-truncate">@ad.Title</h5>
                        <p class="card-text text-muted text-truncate">@ad.Description</p>
                        <div class="mt-auto d-flex justify-content-between align-items-center">
                            <span class="fs-5 fw-bold text-primary">€@ad.Price.ToString("N0")</span>
                            <a href="ads/@ad.Id" class="btn btn-outline-primary btn-sm">Vezi detalii</a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}

@code {
    private PagedResult<AdDto>? pagedResult;
    private bool isLoading = true;
    private bool hasError = false;

    protected override async Task OnInitializedAsync()
    {
        await LoadAds();
    }

    private async Task LoadAds()
    {
        isLoading = true;
        hasError = false;

        pagedResult = await AdService.GetAdsAsync();

        if (pagedResult == null)
        {
            hasError = true;
        }

        isLoading = false;
    }
}